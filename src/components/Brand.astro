---
interface Props {
  footer?: boolean;
}

const { footer = false } = Astro.props;
---

<span class:list={["brand", { "brand--footer": footer }]}>
  <svg class="brand__mark" viewBox="0 0 48 54" aria-hidden="true">
    <circle cx="24" cy="23" r="18" fill="none" stroke="currentColor" stroke-width="4"></circle>
    <path d="M37 22c-13 0-12 7-6 13l3 3c6 7 1 11-7 11" fill="none" stroke="currentColor" stroke-width="4.4"></path>
  </svg>
  {
    footer ? (
      <span class="brand__footer-name">Quare Software</span>
    ) : (
      <span class="brand__wordmark">
        <strong>Quare</strong>
        <small>Software</small>
      </span>
    )
  }
</span>

<style>
  .brand { display: inline-flex; align-items: center; gap: .7rem; color: var(--color-paper); }
  .brand__mark { width: 2.7rem; height: 3rem; flex: none; }
  .brand__wordmark { display: flex; flex-direction: column; align-items: flex-start; gap: .18rem; line-height: .92; }
  .brand__wordmark strong { font-size: 1.85rem; font-weight: 650; letter-spacing: -.065em; }
  .brand__wordmark small { margin-left: .15rem; font-family: var(--font-mono); font-size: .48rem; font-weight: 500; letter-spacing: .23em; text-transform: uppercase; }
  .brand--footer { gap: .65rem; }
  .brand--footer .brand__mark { width: 2.1rem; height: 2.4rem; }
  .brand__footer-name { font-size: 1rem; color: var(--color-muted); }

  @media (max-width: 43.75rem) {
    .brand__mark { width: 2.2rem; height: 2.5rem; }
    .brand__wordmark strong { font-size: 1.5rem; }
    .brand__wordmark small { font-size: .39rem; }
  }
</style>
