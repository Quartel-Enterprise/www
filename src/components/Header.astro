---
import Brand from './Brand.astro';
---

<header class="relative z-20 px-[var(--page-gutter)] pt-6 max-sm:pt-4">
  <nav class="header-nav relative mx-auto flex min-h-18 w-full max-w-[77.5rem] items-center justify-between gap-4 py-2 max-sm:min-h-16 max-sm:gap-2" aria-label="Navegação principal">
    <a class="nav-link" href="#cultura">A Quare</a>
    <a class="header-logo rounded-sm" href="#inicio" aria-label="Quare Software, início"><Brand /></a>
    <a class="nav-link" href="#solucoes"><span class="inline-flex gap-1"><span>Nossos</span><span>produtos</span></span></a>
  </nav>
</header>

<style>
  .nav-link { display: inline-flex; min-height: 2.75rem; align-items: center; color: color-mix(in oklch, var(--color-paper) 72%, transparent); font-size: .8rem; text-underline-offset: .35rem; transition: color 180ms ease; }
  .nav-link:hover { color: var(--color-paper); text-decoration: underline; }
  .header-logo { position: absolute; top: 50%; left: 50%; display: grid; width: max-content; place-items: center; line-height: 0; transform: translate(-50%, -50%); }

  @media (max-width: 37.5rem) {
    .nav-link { font-size: .66rem; }
  }
</style>
