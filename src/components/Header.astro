---
import Brand from './Brand.astro';
---

<header class="relative z-20 px-[var(--page-gutter)] pt-6 max-sm:pt-4">
  <nav class="header-nav mx-auto grid min-h-18 w-full max-w-[77.5rem] grid-cols-[1fr_auto_1fr] items-center gap-4 py-2 max-sm:min-h-16 max-sm:gap-2" aria-label="Navegação principal">
    <a class="nav-link justify-self-start" href="#cultura">A Quare</a>
    <a class="rounded-sm justify-self-center" href="#inicio" aria-label="Quare Software, início"><Brand /></a>
    <a class="nav-link justify-self-end" href="#solucoes"><span class="inline-flex gap-1"><span>Nossos</span><span>produtos</span></span></a>
  </nav>
</header>

<style>
  .nav-link { display: inline-flex; min-height: 2.75rem; align-items: center; color: color-mix(in oklch, var(--color-paper) 72%, transparent); font-size: .8rem; text-underline-offset: .35rem; transition: color 180ms ease; }
  .nav-link:hover { color: var(--color-paper); text-decoration: underline; }

  @media (max-width: 37.5rem) {
    .nav-link { font-size: .66rem; }
  }
</style>
